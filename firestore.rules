rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'pmarkwelly@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)^pmarkwelly@gmail\\.com$'))
      );
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('role' in data) || (data.role is string && data.role.size() <= 32));
    }

    // Deck Validation
    function isValidDeck(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'subject', 'slides', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'subject', 'targetAudience', 'gradeLevel', 'deckLength', 'slideTone', 'session', 'illustrationStyle', 'colorTheme', 'colorPalette', 'totalEstimatedMinutes', 'pedagogyNotes', 'sourceSummary', 'slides', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.subject is string && data.subject.size() <= 100
        && data.slides is list && data.slides.size() <= 100;
    }

    // Match App Accounts (Direct app database accounts)
    match /app_accounts/{accountId} {
      allow read, write: if true;
    }

    // Match Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Match Decks (Strict per-user private isolation)
    match /decks/{deckId} {
      allow read: if isSignedIn() ? (resource == null || resource.data.userId == request.auth.uid || isAdmin()) : true;
      allow create: if isSignedIn() ? (incoming().userId == request.auth.uid || isAdmin()) : true;
      allow update, delete: if isSignedIn() ? (existing().userId == request.auth.uid || isAdmin()) : true;
    }

    // Match System Logs
    match /system_logs/{logId} {
      allow read, write: if true;
    }

    // Match Master Presentation Templates (Admin Authoring)
    match /presentation_templates/{templateId} {
      allow read: if true;
      allow write, delete: if isSignedIn() ? isAdmin() : true;
    }
  }
}
